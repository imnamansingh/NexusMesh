FROM node:22-bookworm-slim AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

ARG VITE_BACKEND_URL=http://localhost:3000
ARG VITE_CONNECTION_TIMEOUT_LIMIT=300000
ARG VITE_LEDGER_CONTRACT_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
ARG VITE_MESH_TOKEN_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

ENV VITE_BACKEND_URL=${VITE_BACKEND_URL}
ENV VITE_CONNECTION_TIMEOUT_LIMIT=${VITE_CONNECTION_TIMEOUT_LIMIT}
ENV VITE_LEDGER_CONTRACT_ADDRESS=${VITE_LEDGER_CONTRACT_ADDRESS}
ENV VITE_MESH_TOKEN_CONTRACT_ADDRESS=${VITE_MESH_TOKEN_CONTRACT_ADDRESS}

RUN npm run build

FROM nginx:alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]